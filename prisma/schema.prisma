generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String?
  location        String
  eventDate       DateTime
  price           Int      // Simpan harga dalam integer (Rupiah) agar presisi
  totalQuota      Int
  availableQuota  Int      // Kolom krusial untuk concurrency locking nanti
  orders          Order[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("events")
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  eventId    String
  quantity   Int
  totalPrice Int
  status     OrderStatus @default(PAID)
  user       User        @relation(fields: [userId], references: [id])
  event      Event       @relation(fields: [eventId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([eventId])
  @@map("orders")
}